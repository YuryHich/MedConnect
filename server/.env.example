# Строка подключения к PostgreSQL
DATABASE_URL=postgres://medconnect:medconnect@localhost:5432/medconnect

# true - выводить SQL-запросы Sequelize в консоль
DB_LOGGING=false

# true - использовать SSL (требуется для облачных БД: Neon, Supabase)
DB_SSL=false

# Порт HTTP-сервера
PORT=3000

# Секретный ключ для подписи JWT (в реальном проекте - длинная случайная строка)
JWT_SECRET=change-me-to-a-long-random-string
# Время жизни токена доступа
JWT_EXPIRES_IN=1h

# Разрешённый origin для CORS (адрес React-приложения)
CORS_ORIGIN=*

# Строка подключения к MongoDB (локально в Docker или кластер MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/medconnect
